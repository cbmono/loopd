{
  // Multi-root editor view for this loopd instance:
  //   • "loopd"                        →  this instance's own files (.)
  //   • "repositories"                 →  the group folder (..) with the product
  //                                       repos, beside which this bridge lives
  //
  // Open it in VSCode, Antigravity, Cursor, or a similar IDE via 
  // File > Open Workspace from File… to get the unified
  // tree: the control panel pinned on top, all the group's repos below.
  //
  // This ONLY changes how the editor displays things. The control panel and the
  // product repos stay PHYSICAL PEERS on disk — they are never nested — so a
  // product-repo session never inherits this instance's control-panel CLAUDE.md.
  // The files.exclude globs hide the bridge folder from the "group repos" pane so
  // it isn't shown twice. BOTH bundle prefixes are listed, because both exist — the
  // bundle repos were renamed `_ai-bridge-*` -> `_loopd-*` and the local directories
  // may be on either side of that; one pattern alone shows a renamed bundle twice.
  //
  // terminal.integrated.cwd pins every new terminal to the instance dir, whichever
  // pane is selected. A multi-root workspace chooses the terminal's folder
  // SEPARATELY from the editor's, so without this a terminal lands in the group
  // root (`..`) — which has none of the instance's `.claude/`, so the bundle's LINKED
  // agents, its SessionStart banner and this panel's CLAUDE.md silently aren't there.
  // (Whatever the loopd PLUGIN carries is per machine and survives either way.)
  // Launching Claude from an editor integration doesn't hit this (it uses the first folder); a terminal launch
  // does, which is the only way to use a wrapper launcher (a script that sets up
  // the environment and then execs `claude`). /loopd:init uncomments the line below
  // with this instance's absolute path; if you hand-copy this file, fill it in
  // yourself. Absolute rather than ${workspaceFolder:loopd} on purpose:
  // substitution in this setting isn't guaranteed across editors, and a silently
  // unresolved value reproduces the exact bug it exists to prevent. It ships
  // COMMENTED OUT so an unsubstituted copy — this seed opened in the template
  // repo, or a hand-copy someone forgot to edit — merely loses the pin, instead
  // of pointing every terminal at a nonexistent directory named "__BRIDGE_DIR__"
  // (VS Code then refuses to launch a terminal at all). Explicitly right-clicking
  // a repo > "Open in Integrated Terminal" still wins, so per-repo terminals keep
  // working.

  "folders": [
    { "name": "loopd", "path": "." },
    { "name": "repositories", "path": ".." }
  ],
  // search.followSymlinks is off because the instance also carries `repos/`, a
  // symlink-per-repo view of the same repos (scripts/link-repos.sh). With it on —
  // the editor default — every hit in a product repo is reported twice: once
  // through the "repositories" folder above and once through `repos/<name>`.
  // Turning it off costs nothing here, since that folder opens the group
  // directly rather than through a link.
  "settings": {
    // "terminal.integrated.cwd": "__BRIDGE_DIR__",
    "search.followSymlinks": false,
    "files.exclude": {
      "_ai-bridge-*": true,
      "_loopd-*": true
    }
  }
}
